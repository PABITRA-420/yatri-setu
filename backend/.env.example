# ==============================================================================
# Yatri Setu (Smart India Hackathon 2026) — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Server & Runtime Environment
PROJECT_NAME="Yatri Setu API"
VERSION="1.0.0"
ENVIRONMENT="development" # development | staging | production

# Database Configuration
# In local development / tests: defaults to local SQLite (sqlite:///./yatri_setu.db)
# In production (Render / Neon / Supabase): set to PostgreSQL connection string
# Format: postgresql://username:password@hostname:5432/database_name
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/yatri_setu"

# CORS Configuration
# Comma-separated allowed frontend origins for CORS.
# For local development: http://localhost:3000,http://127.0.0.1:3000
# For Vercel production deployment: https://your-yatri-setu.vercel.app
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Weather Provider Configuration
# Options: demo | openweather | unavailable
# - openweather: Live meteorological observations from OpenWeatherMap API
# - demo: High-fidelity deterministic mountain weather simulator (default, zero keys required)
# - unavailable: Fallback simulator testing degraded connectivity
WEATHER_PROVIDER="openweather"
WEATHER_API_KEY="" # OpenWeather API key (backend only; never exposed to browser)

# AI Provider Configuration (Primary: Gemini | Fallback: Groq | Final Fallback: Mock)
# - Gemini and Groq are strictly language-generation providers for itineraries.
# - They do NOT calculate crowd pressure, carrying capacity, safety, or booking decisions.
AI_PROVIDER="gemini"
GEMINI_API_KEY="" # Google Gemini API key (backend only; never exposed to browser)
GEMINI_MODEL="gemini-3.6-flash"

AI_FALLBACK_PROVIDER="groq"
GROQ_API_KEY="" # Groq API key for high-speed fallback (backend only; never exposed to browser)
GROQ_MODEL="openai/gpt-oss-120b"

# Optional / Legacy AI Settings (preserved for backward compatibility)
OPENAI_API_KEY="" # OpenAI API key (backend only; optional)
OPENAI_MODEL="gpt-4o-mini"

# Map / Route Provider Configuration
# Yatri Setu provides curated, topological Himalayan mountain routes and shared eco-jeep models.
# No external Google Maps or Mapbox key is required for default operation.
MAPS_API_KEY=""

# Traffic Provider Configuration
# Options: demo | unavailable
TRAFFIC_PROVIDER="demo"
TRAFFIC_API_KEY=""

# Administrative Access & Security
# Optional secret token required for administrative mutations when set.
# If omitted or empty, administrative endpoints remain open for frictionless local evaluation.
ADMIN_SECRET_KEY=""

# Application-Side Rate Limiting (Reduces risk of client quota spikes; upstream quotas are account/tier dependent)
RATE_LIMIT_AI_PER_MINUTE="60"
RATE_LIMIT_SOS_PER_MINUTE="120"
RATE_LIMIT_GENERAL_PER_MINUTE="300"
